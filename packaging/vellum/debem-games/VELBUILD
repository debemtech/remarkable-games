maintainer="Rafael de Bem <rafael.bem@debem.dev>"
pkgname=debem-games
pkgver=0.1.2
pkgrel=0
upstream_author="debemtech"
category="apps"
pkgdesc="Chess, Sudoku, Mahjong, Blackjack, Solitaire and Crossword for AppLoad"
url="https://github.com/$upstream_author/remarkable-games"
arch="aarch64"
license="GPL-3.0-only"
# Built and tested for the Paper Pro only
_depends="appload !rmppm !rmppure"
# This package installs all six games, or each can be installed alone
depends="$_depends
	debem-chess
	debem-sudoku
	debem-mahjong
	debem-blackjack
	debem-solitaire
	debem-crossword
"
readmeurl="https://raw.githubusercontent.com/$upstream_author/remarkable-games/v$pkgver/README.md"

subpackages="
	debem-chess:_chess
	debem-sudoku:_sudoku
	debem-mahjong:_mahjong
	debem-blackjack:_blackjack
	debem-solitaire:_solitaire
	debem-crossword:_crossword
"

# Chess plays against Stockfish.
_stockfish=sf_19
_net=nn-1a298aa575a0.nnue
source="
remarkable-games-$pkgver.tar.gz::https://github.com/$upstream_author/remarkable-games/archive/refs/tags/v$pkgver.tar.gz
Stockfish-$_stockfish.tar.gz::https://github.com/official-stockfish/Stockfish/archive/refs/tags/$_stockfish.tar.gz
$_net::https://tests.stockfishchess.org/api/nn/$_net
"
builddir="$srcdir/remarkable-games-$pkgver"
options="!check !strip"

image="eeems/remarkable-toolchain:5.6.75-rmpp"

build() {
	set -e
	apt-get update
	apt-get install -y golang-go
	. "$(find /opt/codex -name 'environment-setup-*' -type f | head -n1)"

	# Stockfish for the Paper Pro's Cortex-A53 (no dot product instructions)
	cd "$srcdir/Stockfish-$_stockfish/src"
	cp "$srcdir/$_net" .
	make -j"$(nproc)" build ARCH=armv8 COMP=gcc CXX="$CXX"
	$STRIP stockfish

	# The games: Go backends (no cgo) and Qt resources
	cd "$builddir"
	for game in chess sudoku mahjong blackjack solitaire crossword; do
		RCC="$OECORE_NATIVE_SYSROOT/usr/libexec/rcc" \
		STOCKFISH_BIN="$srcdir/Stockfish-$_stockfish/src/stockfish" \
		GOTOOLCHAIN=local GOFLAGS=-trimpath \
			./build.sh "$game" rmpp
	done
}

package() {
	_licenses "$pkgdir" "$pkgname"
}

# Installs one game into AppLoad
_game() {
	install -d "$subpkgdir"/home/root/xovi/exthome/appload
	cp -r "$builddir/build/$1-rmpp" "$subpkgdir/home/root/xovi/exthome/appload/$1"
	_licenses "$subpkgdir" "$subpkgname"
}

_licenses() {
	install -Dm644 "$builddir"/LICENSE "$1"/home/root/.vellum/licenses/$2/LICENSE
	echo "$url" > "$1"/home/root/.vellum/licenses/$2/SOURCES
}

_chess() {
	pkgdesc="Chess against Stockfish or a friend, with save slots and a PGN viewer (AppLoad)"
	depends="$_depends"
	package() {
		_game chess
		install -Dm644 "$srcdir/Stockfish-$_stockfish/Copying.txt" \
			"$subpkgdir"/home/root/.vellum/licenses/$subpkgname/LICENSE.stockfish
		echo "https://github.com/official-stockfish/Stockfish" >> \
			"$subpkgdir"/home/root/.vellum/licenses/$subpkgname/SOURCES
	}
	postdeinstall() { [ "$VELLUM_PURGE" != "1" ] || rm -rf /home/root/.config/chess; }
}

_sudoku() {
	pkgdesc="Sudoku with notes, colors and four difficulties (AppLoad)"
	depends="$_depends"
	package() { _game sudoku; }
	postdeinstall() { [ "$VELLUM_PURGE" != "1" ] || rm -rf /home/root/.config/sudoku; }
}

_mahjong() {
	pkgdesc="Mahjong solitaire (AppLoad)"
	depends="$_depends"
	package() { _game mahjong; }
	postdeinstall() { [ "$VELLUM_PURGE" != "1" ] || rm -rf /home/root/.config/mahjong; }
}

_blackjack() {
	pkgdesc="Blackjack against the dealer, played in landscape (AppLoad)"
	depends="$_depends"
	package() { _game blackjack; }
	postdeinstall() { [ "$VELLUM_PURGE" != "1" ] || rm -rf /home/root/.config/blackjack; }
}

_solitaire() {
	pkgdesc="Klondike and FreeCell solitaire, played in landscape (AppLoad)"
	depends="$_depends"
	package() { _game solitaire; }
	postdeinstall() { [ "$VELLUM_PURGE" != "1" ] || rm -rf /home/root/.config/solitaire; }
}

_crossword() {
	pkgdesc="Crosswords written with the pen, free puzzles in English and Portuguese (AppLoad)"
	depends="$_depends"
	package() { _game crossword; }
	postdeinstall() { [ "$VELLUM_PURGE" != "1" ] || rm -rf /home/root/.config/crossword; }
}

